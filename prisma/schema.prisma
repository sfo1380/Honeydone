generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A Honeydone household: always exactly two partners once both have joined.
model Household {
  id               String    @id @default(cuid())
  name             String
  timeZone         String    @default("America/New_York")
  /// Code in the partner invite link. Cleared once the household is full.
  inviteCode       String?   @unique
  /// Head-to-head weekly crown. Off by default: every couple starts in co-op mode.
  competition      Boolean   @default(false)
  /// Household-local date competition was last switched on. Crowns only count weeks starting on or after it.
  competitionSince DateTime? @db.Date
  /// Weekly team goal: percent of due chores done on time.
  teamGoal         Int       @default(80)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  members    User[]
  kids       Kid[]
  chores     Chore[]
  tasks      ChoreTask[]
  lists      ShoppingList[]
  items      ShoppingItem[]
  coupons    Coupon[]
  awards     Award[]
  activities Activity[]
  events     ActivityEvent[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  color        String   @default("#e11d48")
  householdId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  household      Household?      @relation(fields: [householdId], references: [id], onDelete: SetNull)
  sessions       Session[]
  choresOwned    Chore[]         @relation("ChoreOwner")
  tasksAssigned  ChoreTask[]     @relation("TaskAssignee")
  tasksCompleted ChoreTask[]     @relation("TaskCompleter")
  itemsAdded     ShoppingItem[]  @relation("ItemAdder")
  couponsGiven   Coupon[]        @relation("CouponGiver")
  awardsWon      Award[]         @relation("AwardWinner")
  dropOffs       ActivityEvent[] @relation("DropOff")
  pickUps        ActivityEvent[] @relation("PickUp")

  @@index([householdId])
}

model Session {
  id        String   @id @default(cuid())
  /// SHA-256 of the cookie token; the raw token is never stored.
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Kid {
  id          String   @id @default(cuid())
  householdId String
  name        String
  createdAt   DateTime @default(now())

  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@index([householdId])
}

enum Effort {
  SMALL
  MEDIUM
  LARGE
}

enum Repeat {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

/// A chore and its repeat rule. Each due date is a ChoreTask.
model Chore {
  id          String   @id @default(cuid())
  householdId String
  title       String
  notes       String?
  category    String   @default("Other")
  effort      Effort   @default(MEDIUM)
  /// Who usually does it. Null means either partner.
  ownerId     String?
  /// Alternate the owner between partners each time it repeats.
  rotate      Boolean  @default(false)
  repeat      Repeat   @default(NONE)
  /// Every N days, weeks or months.
  interval    Int      @default(1)
  /// Days of the week for WEEKLY (0 = Sunday ... 6 = Saturday).
  weekdays    Int[]
  /// First due date; anchors weekly and monthly repeats.
  startDate   DateTime @db.Date
  /// Optional time of day, "HH:MM".
  dueTime     String?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner     User?       @relation("ChoreOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks     ChoreTask[]

  @@index([householdId, archived])
}

/// One due date of a chore. Completing it creates the next one for repeating chores.
model ChoreTask {
  id            String    @id @default(cuid())
  choreId       String
  householdId   String
  dueDate       DateTime  @db.Date
  /// Null means either partner.
  assigneeId    String?
  completedAt   DateTime?
  /// The household-local date it was completed on.
  completedOn   DateTime? @db.Date
  completedById String?
  /// Done on or before its due date (household time zone). Feeds the reward tracker.
  onTime        Boolean?
  createdAt     DateTime  @default(now())

  chore       Chore     @relation(fields: [choreId], references: [id], onDelete: Cascade)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completedBy User?     @relation("TaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([choreId, dueDate])
  @@index([householdId, completedAt, dueDate])
}

model ShoppingList {
  id          String   @id @default(cuid())
  householdId String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     ShoppingItem[]

  @@index([householdId])
}

/// An item on a list. "Clear checked" sets clearedAt instead of deleting, so past items can be suggested again.
model ShoppingItem {
  id          String    @id @default(cuid())
  listId      String
  householdId String
  name        String
  quantity    String?
  note        String?
  category    String    @default("Other")
  checkedAt   DateTime?
  clearedAt   DateTime?
  addedById   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  list      ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  addedBy   User?        @relation("ItemAdder", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([listId, clearedAt])
  @@index([householdId, name])
}

/// A coupon one partner offers the other, e.g. "I handle bedtime solo". Rewards are coupons only.
model Coupon {
  id          String   @id @default(cuid())
  householdId String
  /// The partner who will do it when the coupon is used.
  giverId     String
  title       String
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  giver     User      @relation("CouponGiver", fields: [giverId], references: [id], onDelete: Cascade)
  awards    Award[]

  @@index([householdId, giverId])
}

enum AwardReason {
  /// The couple hit the weekly team goal; each partner gets one.
  TEAM_GOAL
  /// Most points that week, when head-to-head is on. A tie crowns both.
  CROWN
}

/// A coupon a partner won for a finished week. They pick which coupon from their partner's book.
model Award {
  id          String      @id @default(cuid())
  householdId String
  winnerId    String
  /// The Sunday starting the week it was won for.
  weekStart   DateTime    @db.Date
  reason      AwardReason
  couponId    String?
  /// Copied when picked, so editing the coupon book later doesn't change a won coupon.
  couponTitle String?
  chosenAt    DateTime?
  usedAt      DateTime?
  createdAt   DateTime    @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  winner    User      @relation("AwardWinner", fields: [winnerId], references: [id], onDelete: Cascade)
  coupon    Coupon?   @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@unique([householdId, weekStart, winnerId, reason])
  @@index([householdId, usedAt])
}

enum EventKind {
  PRACTICE
  GAME
  OTHER
}

/// One kid's sport or program for a season, e.g. "Emma: spring soccer".
model Activity {
  id           String   @id @default(cuid())
  householdId  String
  kidId        String
  name         String
  team         String?
  coachName    String?
  coachContact String?
  location     String?
  seasonStart  DateTime @db.Date
  seasonEnd    DateTime @db.Date
  /// What to bring to every practice and game.
  bringList    String[]
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  household Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  kid       Kid                @relation(fields: [kidId], references: [id], onDelete: Cascade)
  schedules ActivitySchedule[]
  events    ActivityEvent[]

  @@index([householdId])
}

/// A weekly slot ("Practice, Tue and Thu, 5:30 to 7 PM"). Its events are created for the whole season.
model ActivitySchedule {
  id               String    @id @default(cuid())
  activityId       String
  kind             EventKind @default(PRACTICE)
  weekdays         Int[]
  startTime        String
  endTime          String?
  location         String?
  defaultDropOffId String?
  defaultPickUpId  String?
  createdAt        DateTime  @default(now())

  activity Activity        @relation(fields: [activityId], references: [id], onDelete: Cascade)
  events   ActivityEvent[]

  @@index([activityId])
}

/// One practice, game or event on one date. Drivers are set per event.
model ActivityEvent {
  id          String    @id @default(cuid())
  activityId  String
  householdId String
  /// Set when the event came from a weekly schedule.
  scheduleId  String?
  /// The schedule slot this event fills, even if it was moved to another date.
  slotDate    DateTime? @db.Date
  /// Edited by hand (time, place, type or date), so schedule changes leave it alone.
  customized  Boolean   @default(false)
  kind        EventKind @default(PRACTICE)
  title       String?
  date        DateTime  @db.Date
  startTime   String
  endTime     String?
  location    String?
  notes       String?
  dropOffId   String?
  pickUpId    String?
  cancelled   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  activity  Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  household Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  schedule  ActivitySchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  dropOff   User?             @relation("DropOff", fields: [dropOffId], references: [id], onDelete: SetNull)
  pickUp    User?             @relation("PickUp", fields: [pickUpId], references: [id], onDelete: SetNull)

  @@unique([scheduleId, slotDate])
  @@index([householdId, date])
}
